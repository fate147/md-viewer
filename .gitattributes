# 默认：Git 自动判定文本，检出统一 LF
* text=auto eol=lf

# ---------- 必须 CRLF ----------
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
# cmd.exe 对 LF 换行下的 goto / label 解析不可靠，run.bat 必须 CRLF

# ---------- 必须 LF ----------
*.sh    text eol=lf
*.py    text eol=lf
*.pyw   text eol=lf
*.cs    text eol=lf
# 上述脚本在 Git Bash / WSL / csc 下执行，LF 才安全

# ---------- 二进制 ----------
*.ico   binary
*.exe   binary
*.png   binary
*.dll   binary
*.pyd   binary

# ---------- 生成物：不参与 diff 与语言统计 ----------
src/assets/cm6.bundle.js     -diff linguist-generated=true
src/assets/highlight.min.js  -diff linguist-generated=true
src/assets/marked.min.js     -diff linguist-generated=true
src/assets/*.min.css         -diff linguist-generated=true
tools/cm6/package-lock.json  -diff linguist-generated=true

# ---------- 文档目录不计入语言统计 ----------
specs/** linguist-documentation=true
docs/**  linguist-documentation=true
