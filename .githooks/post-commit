#!/bin/bash
# post-commit hook: 自动同步文档
#
# 每次 commit 后运行 docs/sync.py，归档过时文档并生成模块索引。
#
# 关键点：
# 1. sync.py --git 内部已 `git add docs/`，所以要判断的是**暂存区**
#    （git diff --cached），不是工作区（git diff，此时恒为空）。
# 2. docs/sync.py 的 generate_module_index() 把"生成时间"行视为易变字段，
#    实质内容（模块数/行数表）不变就跳过写入。因此无实质变化时这里不会
#    产生只差时间戳的假 commit。
# 3. --no-verify 只跳过 pre-commit / commit-msg，post-commit 仍会触发，
#    故用 MDV_SYNC_DEPTH 限制嵌套层数兜底。
#
# 本文件位于 .githooks/（受版本控制），由 core.hooksPath 启用。

cd "$(git rev-parse --show-toplevel)" || exit 0

if [ -n "$MDV_SYNC_DEPTH" ]; then
    exit 0
fi

python docs/sync.py --git 2>/dev/null

if ! git diff --cached --quiet -- docs/; then
    MDV_SYNC_DEPTH=1 git commit -m "docs: auto-sync after commit" --no-verify
fi
